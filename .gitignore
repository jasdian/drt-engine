# Bench scratch that must NOT be committed:
#  - manifests carry a gh token in their env block
#  - jail is transient leaf working-dir scratch
bench/artifacts/manifests/
bench/artifacts/jail/

# Bench outputs are generated locally (`leaf-bench ground-truth | run | report`),
# not shipped. They are recorded GitHub API traffic that contains third-party
# data (issue text, contributor emails).
bench/cassette/
bench/cassette-live-control/
bench/artifacts/runs/
bench/artifacts/runs-live/
bench/artifacts/groundtruth-*.jsonl
bench/artifacts/livegt-*.jsonl

# runtime spend ledger, regenerated by leaf-bench
bench/budget.jsonl
